# Copy to `config.env` in this directory (or run: uv run np init-config).
# `config.env` is gitignored — do not commit passwords or machine-specific paths.
#
# Precedence (highest wins):
#   1. Shell environment variables already exported in your terminal
#   2. This file (only sets keys that are not already in the environment)
#   3. Built-in defaults in the application
#
# To override a value for one command:
#   NOW_PLAYING_SOURCE=spotify uv run np current

# --- Source and idle text ---

# auto | apple_music | spotify
# auto: Apple Music if playing; else Spotify if playing; else Apple Music if
#       Music is running (idle/paused); else Spotify.
NOW_PLAYING_SOURCE=auto

# Written to `_data/current_song.txt` when nothing is playing.
# Leave empty for a blank file while idle.
NOW_PLAYING_IDLE_TEXT=

# --- HTTP server ---

NOW_PLAYING_HOST=127.0.0.1
NOW_PLAYING_PORT=8976

# --- Overlay defaults (Browser Source: /overlay, /spotify/overlay) ---
# URL query params override these at request time.

NOW_PLAYING_OVERLAY_PRESET=compact
NOW_PLAYING_OVERLAY_HIDE_STATUS=0
NOW_PLAYING_OVERLAY_MAX_LINES=2
NOW_PLAYING_OVERLAY_PANEL_OPACITY=0.64

# Optional HTML template overrides (leave blank to use bundled templates).
# NOW_PLAYING_DASHBOARD_TEMPLATE_PATH=
# NOW_PLAYING_OVERLAY_TEMPLATE_PATH=
# NOW_PLAYING_TEMPLATE_DIR=

# --- Polling and logging ---

INTERVAL_SECONDS=5
PYTHON_LOG_LEVEL=INFO

# --- LaunchAgent ---

# Change only for multiple installs or a custom service name.
NOW_PLAYING_LAUNCHD_LABEL=com.funkatron.now-playing

# --- Spotify terminal session (start-spotify-session) ---
# UNSTABLE: separate Terminal/iTerm worker + spotify_* files + /spotify/* HTTP.
# Prefer Apple Music + LaunchAgent for production until this path stabilizes.

# auto | iterm | terminal
NOW_PLAYING_SPOTIFY_TERMINAL=auto

# --- OBS WebSocket (optional) ---
# Leave OBSWS_ENABLED=0 if OBS reads `_data/` files or Browser Source only.
# WebSocket push is enabled only when this value is exactly 1.

OBSWS_ENABLED=0
OBSWS_HOST=localhost
OBSWS_PORT=4455
OBSWS_PASSWORD=

OBSWS_IMAGE_INPUT_NAME=NPImage

# Leave blank if OBS reads `_data/current_song.txt` directly.
# OBSWS_TEXT_INPUT_NAME=
OBSWS_TEXT_FIELD=text
