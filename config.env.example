# Copy this file to `config.env` and edit it for your machine.
# The service loads these values automatically.

# Which player should be treated as the source of truth:
# - auto: prefer Apple Music if it is actively playing, otherwise Spotify
# - apple_music: only read Apple Music
# - spotify: only read Spotify
NOW_PLAYING_SOURCE=auto

# Text written to `_data/current_song.txt` when nothing is playing.
# Leave blank if you want the file to be empty while idle.
NOW_PLAYING_IDLE_TEXT=

# Local HTTP API bind address.
# Keep `127.0.0.1` unless you intentionally want remote access.
NOW_PLAYING_HOST=127.0.0.1
NOW_PLAYING_PORT=8976

# Overlay defaults for Browser Source URLs (`/overlay` and `/spotify/overlay`).
# URL query params override these values at runtime.
# Preset: compact|tv
NOW_PLAYING_OVERLAY_PRESET=compact
# Hide the PLAYING/IDLE status label on the overlay (`1` to hide, `0` to show).
NOW_PLAYING_OVERLAY_HIDE_STATUS=0
# Maximum lines for title and metadata labels (1-3).
NOW_PLAYING_OVERLAY_MAX_LINES=2
# Panel background opacity (0.20-0.95); lower is more transparent.
NOW_PLAYING_OVERLAY_PANEL_OPACITY=0.64
# Optional absolute paths for template overrides.
# If set, these files replace the bundled HTML templates.
NOW_PLAYING_DASHBOARD_TEMPLATE_PATH=
NOW_PLAYING_OVERLAY_TEMPLATE_PATH=
# Optional directory override searched for `dashboard.html` and `overlay.html`.
NOW_PLAYING_TEMPLATE_DIR=

# Poll interval for checking the active player, in seconds.
# `5` is a good default for overlays; lower values cause more churn.
INTERVAL_SECONDS=5

# Logging level for the daemon and CLI.
# Useful values: DEBUG, INFO, WARNING, ERROR
PYTHON_LOG_LEVEL=INFO

# Optional custom launchd label.
# Change this only if you want multiple installs or a custom service name.
NOW_PLAYING_LAUNCHD_LABEL=com.funkatron.now-playing

# OBS websocket integration is optional.
# Leave `OBSWS_ENABLED=0` if OBS is only reading the flat files directly.
OBSWS_ENABLED=0

# OBS websocket connection settings.
OBSWS_HOST=localhost
OBSWS_PORT=4455
OBSWS_PASSWORD=

# OBS image input name to update with `_data/current_artwork.png`.
OBSWS_IMAGE_INPUT_NAME=NPImage

# Optional OBS text input name.
# Leave blank if OBS should read `_data/current_song.txt` itself instead.
OBSWS_TEXT_INPUT_NAME=

# Field name used by the selected OBS text input.
# `text` is the normal value for standard text sources.
OBSWS_TEXT_FIELD=text
